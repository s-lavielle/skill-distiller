#!/usr/bin/env python3
"""skill-distiller — CLI du workflow de distillation de skills (SKILL.md).

Sans dépendance (bibliothèque standard Python 3). S'exécute depuis la
racine du PROJET CIBLE :

    python3 <chemin>/bin/skill-distiller <init|check|diff|new> <sujet>

La façade MCP (src/mcp_server.py) sert les mêmes commandes et le skill
aux agents compatibles :

    python3 <chemin>/bin/skill-distiller mcp [--http HOST:PORT]

Artefacts dans <racine>/<sujet>/ (racine par défaut : threads/,
surcharge par --dir — voir SKILL.md, section « Artefacts »).
"""

import argparse
import difflib
import filecmp
import re
import sys
import urllib.request
from datetime import datetime
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TEMPLATES_DIR = ROOT / "templates"

FILES = {
    "fiche": "00-fiche-sources.yaml",
    "brute": "01-synthese-brute.md",
    "reconciliation": "02-reconciliation.md",
    "reconciliee": "03-synthese-reconciliee.md",
    "amendements": "04-amendements.md",
    "final": "05-skill-final.md",
}

TEMPLATE_FILES = [
    ("fiche-sources.yaml", FILES["fiche"]),
    ("reconciliation.md", FILES["reconciliation"]),
    ("amendements.md", FILES["amendements"]),
    ("skill-final.md", FILES["final"]),
]


def usage_error(message):
    """Erreur d'usage : message + sortie avec code 2."""
    sys.stderr.write(f"Erreur : {message}\n")
    sys.stderr.write(
        "Usage : skill-distiller <init|check|diff|new> <sujet> "
        "[--dir <racine>] [--force] [--fetch]\n"
        "Aide :  skill-distiller --help\n"
    )
    sys.exit(2)


def slugify(text):
    return re.sub(r"\s+", "-", text.strip())


def is_filled(value):
    """Un champ « rempli » a une valeur qui n'est pas un gabarit <...>."""
    v = (value or "").strip()
    return len(v) > 0 and not v.startswith("<")


def read_if_exists(path):
    path = Path(path)
    return path.read_text(encoding="utf-8") if path.exists() else None


# ------------------------------------------------------------- analyse

def parse_fiche(text):
    """Analyse minimale de la fiche (format contrôlé du template).

    Une entrée : ref, langue, snapshot (copie figée), date_fige.
    """
    entries = []
    langue = None
    current = None
    for line in text.split("\n"):
        m_ref = re.match(r"^\s*-\s*ref:\s*(.*)$", line)
        if m_ref:
            current = {"ref": m_ref.group(1).strip(), "langue": "",
                       "snapshot": "", "date_fige": ""}
            entries.append(current)
            continue
        m_langue = re.match(r"^langue_cible:\s*(.*)$", line)
        if m_langue:
            langue = m_langue.group(1).strip()
            continue
        m_field = re.match(r"^\s+(langue|snapshot|date_fige):\s*(.*)$", line)
        if m_field and current is not None:
            current[m_field.group(1)] = m_field.group(2).strip()
    return entries, langue


def synthesis_headings(text):
    """Titres de la synthèse, au niveau le plus fin (### si présent, sinon ##)."""
    lines = text.split("\n")
    h3 = [line for line in lines if re.match(r"^###\s", line)]
    chosen = h3 if h3 else [line for line in lines if re.match(r"^##\s", line)]
    return [re.sub(r"^#+\s*", "", line).strip() for line in chosen]


def markers_of(heading):
    return re.findall(r"\[([A-Za-z][A-Za-z0-9_-]*)\]", heading)


def clean_heading(heading):
    """Titre du déroulé : sans marqueurs ni numérotation."""
    out = re.sub(r"^#+\s*", "", heading)
    out = re.sub(r"\[[^\]]*\]", "", out)
    out = re.sub(r"^\d+(\.\d+)*\.?\s+", "", out)
    return re.sub(r"\s+", " ", out).strip()


def display_heading(heading):
    """Titre dans les messages : sans marqueurs, avec la numérotation,
    pour que le point signalé soit retrouvable dans le document."""
    out = re.sub(r"^#+\s*", "", heading)
    return re.sub(r"\s+", " ", out).strip()


def front_matter(text):
    lines = text.split("\n")
    if not lines or lines[0].strip() != "---":
        return None
    fields = {}
    for line in lines[1:]:
        if line.strip() == "---":
            return fields
        m = re.match(r"^([A-Za-z0-9_-]+):\s*(.*)$", line)
        if m:
            fields[m.group(1)] = m.group(2).strip()
    return None


# ---------------------------------------------------------------- init

def command_init(args):
    cwd = Path.cwd()
    lot = (cwd / args.dir / slugify(args.sujet)).resolve()
    if lot.exists() and any(lot.iterdir()):
        usage_error(f"répertoire déjà rempli : {lot}")
    lot.mkdir(parents=True, exist_ok=True)
    for template, dest in TEMPLATE_FILES:
        content = (TEMPLATES_DIR / template).read_text(encoding="utf-8")
        content = content.replace("<sujet>", slugify(args.sujet))
        (lot / dest).write_text(content, encoding="utf-8")
        print(f"créé   {Path(args.dir) / slugify(args.sujet) / dest}")

    # Mémoire du lot : les copies figées des sources (réintégration).
    (lot / "sources").mkdir(exist_ok=True)
    print(f"créé   {Path(args.dir) / slugify(args.sujet) / 'sources'}/")

    # Règle du workflow : le répertoire de travail n'est jamais versionné.
    entry = str(args.dir).replace("\\", "/").rstrip("/") + "/"
    gitignore = cwd / ".gitignore"
    existing = read_if_exists(gitignore) or ""
    lines = [line.strip() for line in existing.split("\n")]
    if entry in lines:
        print(f"ignoré {entry} (déjà dans .gitignore)")
    else:
        sep = "\n" if existing and not existing.endswith("\n") else ""
        gitignore.write_text(f"{existing}{sep}{entry}\n", encoding="utf-8")
        print(f"ignoré {entry} (ajouté au .gitignore)")
    print(f"\nLot prêt : {lot}")


# --------------------------------------------------------------- check

def command_check(args):
    cwd = Path.cwd()
    lot = (cwd / args.dir / slugify(args.sujet)).resolve()
    if not lot.exists():
        usage_error(f"lot introuvable : {lot}")

    errors, warnings, ok = [], [], []
    texts = {name: read_if_exists(lot / name) for name in FILES.values()}

    # 1. Fiche de sources
    fiche_text = texts[FILES["fiche"]]
    sources = []
    if fiche_text is None:
        errors.append(f"{FILES['fiche']} manquant")
    else:
        entries, langue = parse_fiche(fiche_text)
        sources = [e for e in entries if is_filled(e["ref"])]
        if not sources:
            errors.append("fiche : aucune source déclarée (ref)")
        else:
            ok.append(f"fiche : {len(sources)} source(s) déclarée(s)")
        if not is_filled(langue):
            warnings.append("fiche : langue_cible absente ou vide (français par défaut)")
        for entry in sources:
            if not is_filled(entry["snapshot"]):
                warnings.append(
                    f"fiche : source « {entry['ref']} » sans copie figée "
                    "(snapshot) — réintégration impossible"
                )

    # 2. Étapes complètes
    multi = len(sources) >= 2
    required = [FILES["fiche"], FILES["brute"], FILES["amendements"], FILES["final"]]
    if multi:
        required += [FILES["reconciliation"], FILES["reconciliee"]]
    for name in required:
        if texts[name] is None:
            errors.append(f"{name} manquant (étape incomplète)")
    ok.append(
        "étapes : sources multiples — réconciliation attendue (02, 03)"
        if multi
        else "étapes : source unique — la synthèse brute fait foi"
    )

    # 3. Traçabilité de la synthèse (03 si présent, sinon 01)
    synth_name = FILES["reconciliee"] if texts[FILES["reconciliee"]] is not None else FILES["brute"]
    synth = texts[synth_name]
    if synth is not None:
        lines = synth.split("\n")
        h3 = [line for line in lines if re.match(r"^###\s", line)]
        headings = h3 if h3 else [line for line in lines if re.match(r"^##\s", line)]
        untraced = 0
        markers = set()
        for heading in headings:
            found = markers_of(heading)
            markers.update(found)
            if not found:
                untraced += 1
                errors.append(
                    f"traçabilité [{synth_name}] : point non tracé — "
                    f"« {display_heading(heading)} »"
                )
        if headings and not markers:
            errors.append(f"traçabilité [{synth_name}] : aucun marqueur de source détecté")
        elif untraced == 0 and headings:
            marks = ", ".join(f"[{m}]" for m in sorted(markers))
            ok.append(
                f"traçabilité [{synth_name}] : {len(headings)} point(s) tracé(s) "
                f"(marqueurs {marks})"
            )

    # 4. Amendements cohérents
    amend = texts[FILES["amendements"]]
    if amend is not None:
        for section in ("Ajouts", "Amendements", "Cadre"):
            if not re.search(rf"^##\s+{section}\b", amend, re.M):
                errors.append(f"amendements : section « {section} » absente")
        m_section = re.search(r"^##\s+Amendements\b.*?(?=^##\s|\Z)", amend, re.M | re.S)
        section = m_section.group(0) if m_section else ""
        entries = re.split(r"^###\s+", section, flags=re.M)[1:]
        for entry in entries:
            title = entry.split("\n")[0].strip()
            for field in ("Cible", "Contenu", "Conséquence"):
                m = re.search(rf"^-\s*{field}\s*:\s*(.*)$", entry, re.M | re.I)
                if not m or not is_filled(m.group(1)):
                    errors.append(
                        f"amendements : « {display_heading(title)} » — "
                        f"champ {field} absent ou à remplir"
                    )
        if entries:
            ok.append(f"amendements : {len(entries)} entrée(s) contrôlée(s)")

    # 5. Skill final rempli
    final = texts[FILES["final"]]
    if final is not None:
        fm = front_matter(final)
        if fm is None:
            errors.append("skill final : front-matter absent")
        else:
            if not is_filled(fm.get("name")):
                errors.append("skill final : name absent ou gabarit")
            if not is_filled(fm.get("description")):
                errors.append("skill final : description absente ou gabarit")
            if is_filled(fm.get("name")) and is_filled(fm.get("description")):
                ok.append("skill final : front-matter rempli")

    rel = lot.relative_to(cwd) if lot.is_relative_to(cwd) else lot
    print(f"Contrôle de {rel}/")
    for line in ok:
        print(f"  ✓ {line}")
    for line in warnings:
        print(f"  ⚠ {line}")
    for line in errors:
        print(f"  ✗ {line}")
    print(f"\n{len(errors)} erreur(s), {len(warnings)} avertissement(s)")
    sys.exit(1 if errors else 0)


# ---------------------------------------------------------------- diff

def walk_files(root):
    """Liste les fichiers d'un chemin (fichier ou arborescence) : rel → abs."""
    root = Path(root)
    out = {}
    if not root.exists():
        return out
    if root.is_file():
        out[root.name] = root
        return out
    for path in root.rglob("*"):
        if path.is_file():
            out[path.relative_to(root).as_posix()] = path
    return out


def is_binary(data):
    return b"\x00" in data


def unified_diff(a_text, b_text, label_a, label_b):
    """Diff unifié (difflib). '' si identique."""
    diff = difflib.unified_diff(
        a_text.splitlines(keepends=True),
        b_text.splitlines(keepends=True),
        fromfile=label_a,
        tofile=label_b,
    )
    return "".join(diff)


def diff_trees(snap_root, cur_root):
    """Compare la copie figée à la source actuelle (fichiers ou répertoires)."""
    snap = walk_files(snap_root)
    cur = walk_files(cur_root)
    added, removed, changed, parts = [], [], [], []
    same = 0
    for rel, abs_path in sorted(cur.items()):
        if rel not in snap:
            added.append(rel)
            continue
        if filecmp.cmp(snap[rel], abs_path, shallow=False):
            same += 1
            continue
        changed.append(rel)
        a_data = snap[rel].read_bytes()
        b_data = abs_path.read_bytes()
        if is_binary(a_data) or is_binary(b_data):
            parts.append(
                f"--- snapshot/{rel}\n+++ actuel/{rel}\n"
                "(fichier binaire modifié, diff non produit)\n"
            )
        else:
            parts.append(
                unified_diff(
                    a_data.decode("utf-8", errors="replace"),
                    b_data.decode("utf-8", errors="replace"),
                    f"snapshot/{rel}",
                    f"actuel/{rel}",
                )
            )
    for rel in snap:
        if rel not in cur:
            removed.append(rel)
    return {"added": added, "removed": removed, "changed": changed,
            "same": same, "patch": "".join(parts)}


def timestamp():
    return datetime.now().strftime("%Y-%m-%d-%H%M")


def http_get(url):
    """Téléchargement ponctuel ; les erreurs deviennent un message."""
    try:
        with urllib.request.urlopen(url, timeout=30) as res:
            return {"text": res.read().decode("utf-8", errors="replace")}
    except Exception as exc:  # URLError, HTTPError, timeout…
        return {"error": f"téléchargement impossible ({exc})"}


def resolve_current(entry, lot, source_id, fetch_enabled):
    """Résout la source actuelle, dans l'ordre : ref locale, puis
    sources-actuelles/<id>/ (dépôt manuel), puis téléchargement d'une
    ref http(s) avec --fetch."""
    ref_path = Path(entry["ref"])
    if not ref_path.is_absolute():
        ref_path = Path.cwd() / ref_path
    if ref_path.exists():
        return {"root": ref_path, "how": "ref locale"}
    manual = lot / "sources-actuelles" / source_id
    if manual.exists():
        return {"root": manual, "how": f"sources-actuelles/{source_id}"}
    if fetch_enabled and re.match(r"^https?://", entry["ref"]):
        got = http_get(entry["ref"])
        if "error" in got:
            return {"error": got["error"]}
        return {"text": got["text"], "how": "téléchargée (--fetch)"}
    return {"unresolved": True}


def command_diff(args):
    cwd = Path.cwd()
    slug = slugify(args.sujet)
    lot = (cwd / args.dir / slug).resolve()
    fiche_text = read_if_exists(lot / FILES["fiche"])
    if fiche_text is None:
        usage_error(f"{FILES['fiche']} introuvable dans {lot}")
    entries = [e for e in parse_fiche(fiche_text)[0] if is_filled(e["ref"])]
    if not entries:
        usage_error("fiche : aucune source déclarée (ref)")

    out_dir = lot / "reintegrations" / timestamp()
    counter = 2
    while out_dir.exists():
        out_dir = lot / "reintegrations" / f"{timestamp()}-{counter}"
        counter += 1
    out_dir.mkdir(parents=True)

    rows, details, instructions = [], [], []
    changes = 0

    for i, entry in enumerate(entries):
        if is_filled(entry["snapshot"]):
            source_id = Path(entry["snapshot"].strip().rstrip("/")).name
        else:
            source_id = f"source-{i + 1}"
        snap_root = (lot / entry["snapshot"]).resolve() if is_filled(entry["snapshot"]) else None
        figee = snap_root is not None and bool(walk_files(snap_root))

        if not figee:
            rows.append((entry["ref"], "—", "non figée"))
            target = entry["snapshot"] or f"sources/{source_id}/"
            details.append(
                f"### {source_id} — {entry['ref']}\n\nPas de copie figée : figer la "
                f"source dans `{target}` (voir SKILL.md, étape 1), puis relancer `diff`.\n"
            )
            continue

        resolved = resolve_current(entry, lot, source_id, args.fetch)
        if "error" in resolved:
            rows.append((entry["ref"], entry["date_fige"] or "—", "erreur"))
            details.append(f"### {source_id} — {entry['ref']}\n\n{resolved['error']}.\n")
            continue
        if resolved.get("unresolved"):
            rows.append((entry["ref"], entry["date_fige"] or "—", "à rafraîchir"))
            details.append(
                f"### {source_id} — {entry['ref']}\n\nSource actuelle non résoluble "
                "automatiquement (ni chemin local, ni URL téléchargeable). Récupérer le "
                "contenu actuel, le déposer dans "
                f"`sources-actuelles/{source_id}/`, puis relancer `diff`.\n"
            )
            instructions.append(f"rafraîchir {source_id} dans sources-actuelles/{source_id}/")
            continue

        if "text" in resolved:
            # Ref téléchargée : comparable seulement à une copie figée en un fichier.
            snap_files = list(walk_files(snap_root).values())
            if len(snap_files) != 1:
                rows.append((entry["ref"], entry["date_fige"] or "—", "à rafraîchir"))
                details.append(
                    f"### {source_id} — {entry['ref']}\n\nContenu téléchargé, mais la "
                    f"copie figée compte {len(snap_files)} fichiers : déposer le contenu "
                    f"actuel dans `sources-actuelles/{source_id}/` et relancer `diff`.\n"
                )
                instructions.append(f"rafraîchir {source_id} dans sources-actuelles/{source_id}/")
                continue
            snap_file = snap_files[0]
            patch = unified_diff(
                snap_file.read_text(encoding="utf-8", errors="replace"),
                resolved["text"],
                f"snapshot/{snap_file.name}",
                "actuel",
            )
            result = ({"added": [], "removed": [], "changed": [], "same": 1, "patch": ""}
                      if patch == "" else
                      {"added": [], "removed": [], "changed": [snap_file.name],
                       "same": 0, "patch": patch})
        else:
            result = diff_trees(snap_root, resolved["root"])

        delta = []
        if result["changed"]:
            delta.append(f"{len(result['changed'])} modifié(s)")
        if result["added"]:
            delta.append(f"{len(result['added'])} nouveau(x)")
        if result["removed"]:
            delta.append(f"{len(result['removed'])} supprimé(s)")
        etat = "identique" if not delta else f"modifié ({', '.join(delta)})"
        rows.append((entry["ref"], entry["date_fige"] or "—", etat))
        if delta:
            changes += 1

        patch_name = f"diff-{source_id}.patch"
        if result["patch"]:
            (out_dir / patch_name).write_text(result["patch"], encoding="utf-8")
        details.append(
            f"### {source_id} — {entry['ref']}\n\n"
            f"Source actuelle : {resolved['how']}. "
            f"Copie figée le {entry['date_fige'] or 'date inconnue'}.\n\n"
            + (
                "Aucun changement détecté.\n"
                if not delta
                else
                f"- Modifiés : {', '.join(result['changed']) or '—'}\n"
                f"- Nouveaux : {', '.join(result['added']) or '—'}\n"
                f"- Supprimés : {', '.join(result['removed']) or '—'}\n"
                + (f"\nDiff : `{patch_name}`\n" if result["patch"] else "")
            )
            + "\n"
        )

    now = datetime.now().strftime("%Y-%m-%d %H:%M")
    report = (
        f"# État des sources — {slug}\n\n"
        f"> Généré par `skill-distiller diff` le {now}. "
        "Première étape de la réintégration (SKILL.md) : comparaison des copies\n"
        "> figées (`sources/<id>/`) aux sources actuelles.\n\n"
        "## Synthèse\n\n"
        "| Source | Figée le | État |\n|---|---|---|\n"
        + "".join(f"| {ref} | {date} | {etat} |\n" for ref, date, etat in rows)
        + f"\n{changes} source(s) avec changements, {len(entries) - changes} sans.\n\n"
        "## Détail\n\n"
        + "\n".join(details) + "\n"
        + (
            f"## À faire avant de poursuivre\n\n"
            + "".join(f"- {item}\n" for item in instructions)
            if instructions else ""
        )
    )
    report_path = out_dir / "01-etat-des-sources.md"
    report_path.write_text(report, encoding="utf-8")

    try:
        shown = report_path.relative_to(cwd)
    except ValueError:
        shown = report_path
    print(f"écrit  {shown}")
    for ref, _date, etat in rows:
        print(f"  {'✓' if etat == 'identique' else '✗'} {ref} — {etat}")
    print("\nSuite (SKILL.md, réintégration) : 02-synthese-nouveautes.md, puis arbitrage.")


# ----------------------------------------------------------------- new

def command_new(args):
    cwd = Path.cwd()
    slug = slugify(args.sujet)
    lot = (cwd / args.dir / slug).resolve()
    synth_name = (FILES["reconciliee"]
                  if read_if_exists(lot / FILES["reconciliee"]) is not None
                  else FILES["brute"])
    synth = read_if_exists(lot / synth_name)
    if synth is None:
        usage_error(
            f"synthèse introuvable dans {lot} "
            f"({FILES['brute']} ou {FILES['reconciliee']})"
        )

    final_path = lot / FILES["final"]
    existing = read_if_exists(final_path)
    if existing is not None and not args.force:
        fm = front_matter(existing)
        if fm is not None and is_filled(fm.get("name")):
            usage_error(
                f"{FILES['final']} existe déjà avec du contenu — "
                "--force pour le régénérer"
            )

    steps = [h for h in (clean_heading(x) for x in synthesis_headings(synth)) if h]
    fiche_text = read_if_exists(lot / FILES["fiche"])
    refs = ([e["ref"] for e in parse_fiche(fiche_text)[0] if is_filled(e["ref"])]
            if fiche_text else [])

    if steps:
        derive = "".join(f"{i + 1}. {s} — <à expliciter d'après la synthèse amendée>.\n"
                         for i, s in enumerate(steps))
    else:
        derive = "1. <à décrire — la synthèse ne porte aucun point tracé.>\n"
    sources_note = ("".join(f"- {r}\n" for r in refs) if refs
                    else "- <aucune source dans la fiche>\n")

    out = (
        "---\n"
        f"name: {slug}\n"
        "description: <à compléter — ce que fait le skill et quand l'utiliser.>\n"
        "---\n\n"
        f"# {args.sujet.strip()}\n\n"
        "## Objectif\n\n"
        "<Le but du skill : le problème qu'il résout, le résultat produit.>\n\n"
        "## Déroulé\n\n"
        + derive + "\n"
        "## Rappels\n\n"
        "- <Règle non évidente, avec sa justification (le pourquoi, pas "
        "seulement le quoi).>\n\n"
        "---\n\n"
        "## Note de sources\n\n"
        "Ce skill s'inspire de :\n"
        + sources_note
        + "À conserver pour l'entretien futur du skill.\n"
    )
    final_path.write_text(out, encoding="utf-8")
    try:
        shown = final_path.relative_to(cwd)
    except ValueError:
        shown = final_path
    print(f"écrit  {shown}")
    print(f"ossature : {len(steps)} étape(s) dérivée(s) de {synth_name}, "
          f"{len(refs)} source(s) citée(s)")
    print("À compléter, puis relancer `check`.")


# ----------------------------------------------------------------- mcp

def command_mcp(args):
    """Démarre la façade MCP (src/mcp_server.py) — agents compatibles."""
    sys.path.insert(0, str(ROOT / "src"))
    import mcp_server
    try:
        mcp_server.serve(args.http)
    except mcp_server.RpcError as exc:
        usage_error(exc.message)


# ---------------------------------------------------------------- main

def build_parser():
    parser = argparse.ArgumentParser(
        prog="skill-distiller",
        description="Workflow de distillation de skills — init, check, diff, new.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    def common(subparser):
        subparser.add_argument("sujet", help="sujet du lot (threads/<sujet>/)")
        subparser.add_argument("--dir", default="threads",
                               help="racine des artefacts (défaut : threads/)")

    p_init = sub.add_parser("init", help="crée le lot et pré-remplit les artefacts")
    common(p_init)

    p_check = sub.add_parser("check", help="vérifie traçabilité et complétude")
    common(p_check)

    p_diff = sub.add_parser("diff", help="compare les sources figées aux sources actuelles")
    common(p_diff)
    p_diff.add_argument("--fetch", action="store_true",
                        help="télécharger les sources http(s)")

    p_new = sub.add_parser("new", help="génère l'ossature du skill final")
    common(p_new)
    p_new.add_argument("--force", action="store_true",
                       help="écraser un 05-skill-final.md déjà rempli")

    p_mcp = sub.add_parser(
        "mcp",
        help="sert la CLI et le skill en MCP (stdio par défaut, HTTP avec --http)",
    )
    p_mcp.add_argument("--http", metavar="HOST:PORT", default=None,
                       help="transport HTTP streamable (défaut : stdio ; "
                            "sinon SKILL_DISTILLER_MCP_ADDR)")
    return parser


def main():
    args = build_parser().parse_args()
    if args.command == "init":
        command_init(args)
    elif args.command == "check":
        command_check(args)
    elif args.command == "diff":
        command_diff(args)
    elif args.command == "new":
        command_new(args)
    elif args.command == "mcp":
        command_mcp(args)


if __name__ == "__main__":
    main()
